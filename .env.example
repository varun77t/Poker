# Copy to .env for local development. In production, set these in the hosting dashboard.

# The port you open in the browser.
#   Development: the Vite dev server listens here (default 5173).
#   Production:  the Node server listens here (hosting platforms usually set it for you).
# PORT=5173

# Development only: the Node API/Socket.IO server port behind the Vite proxy (default 3000).
API_PORT=3000

# development | production | test
NODE_ENV=development

# fatal | error | warn | info | debug
LOG_LEVEL=info

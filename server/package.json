  "devDependencies": {
    "@types/express": "^5.0.6",
    "cross-env": "^10.1.0",
    "fast-check": "^4.10.2",
    "socket.io-client": "^4.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
